# Copy this file to .env and fill in the keys you need:
#   cp .env.example .env
# Load in code with python-dotenv:  from dotenv import load_dotenv; load_dotenv()
# `langgraph dev` reads .env automatically when langgraph.json sets "env": ".env".
# You only need keys for the providers you actually use.

# =========================================================
# Model providers
# =========================================================
# OpenAI (also used for any OpenAI-compatible endpoint via base URL)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com

# OpenRouter
OPENROUTER_API_KEY=

# Alibaba DashScope (Qwen / 通义千问)
DASHSCOPE_API_KEY=

# Tencent Hunyuan (langchain_community ChatHunyuan)
HUNYUAN_APP_ID=
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=

# Tencent Cloud SDK (tencentcloud-sdk-python)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# =========================================================
# Tools
# =========================================================
# Tavily web search
TAVILY_API_KEY=

# =========================================================
# Tracing / observability (LangSmith, used by LangGraph Studio)
# =========================================================
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=langgraph-sandbox

# =========================================================
# Document parsing / models (optional)
# =========================================================
# Unstructured hosted API (only for unstructured-client; local parsing needs no key)
UNSTRUCTURED_API_KEY=

# HuggingFace Hub (only needed for gated/private models)
HF_TOKEN=

# =========================================================
# Databases (no standard variable names; read these in your own code)
# =========================================================
# PostgreSQL checkpointer (langgraph-checkpoint-postgres)
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/langgraph?sslmode=disable

# Milvus vector store
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
